<%- include('../../partials/header') %>
<div class="card-head">
  <h1>Users</h1>
  <a class="button" href="/admin/users/new<%= role ? `?role=${role}` : '' %>">Add user</a>
</div>
<form method="get" action="/admin/users" class="filters">
  <label>Role
    <select name="role">
      <option value="">All roles</option>
      <% Object.keys(ROLE_LABELS).forEach((r) => { %><option value="<%= r %>" <% if (r === role) { %>selected<% } %>><%= roleLabel(r) %></option><% }) %>
    </select>
  </label>
  <label>Search <input name="q" value="<%= q %>" placeholder="Name, username, or email"></label>
  <button class="button secondary" type="submit">Filter</button>
</form>
<section class="card">
  <p class="muted small"><%= users.length %> <%= users.length === 1 ? 'user' : 'users' %></p>
  <table>
    <thead><tr><th>Name</th><th>Role</th><th>Username</th><th>Email</th><th>Status</th><th>Joined</th></tr></thead>
    <tbody>
    <% users.forEach((u) => { %>
      <tr>
        <td><a href="/admin/users/<%= u.id %>"><%= u.last_name %>, <%= u.first_name %></a></td>
        <td><span class="role-badge role-<%= u.role %>"><%= roleLabel(u.role) %></span></td>
        <td><%= u.username %></td>
        <td><%= u.email || '' %></td>
        <td><%= u.active ? 'Active' : 'Turned off' %></td>
        <td class="muted"><%= formatDate(u.created_at) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</section>
<%- include('../../partials/footer') %>
