<%- include('../partials/header') %>
<h1>Welcome, <%= currentUser.first_name %></h1>

<section class="card">
  <h2>My courses</h2>
  <% if (!courses.length) { %>
    <p>You have not been assigned a course yet. CodeCrew staff will assign you once your schedule is set.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Course</th><th>Program</th><th>Schedule</th><th>Students</th><th></th></tr></thead>
      <tbody>
      <% courses.forEach((c) => { %>
        <tr>
          <td><a href="/courses/<%= c.id %>"><%= c.title %></a></td>
          <td><%= c.program_name %> <span class="tag status-<%= c.program_status %>"><%= statusLabel(c.program_status) %></span></td>
          <td><%= c.schedule || '—' %></td>
          <td><%= c.enrolled_count %><% if (c.capacity) { %> / <%= c.capacity %><% } %></td>
          <td class="nowrap">
            <a href="/courses/<%= c.id %>">Manage</a> ·
            <a href="/messages/new?course=<%= c.id %>">Message parents</a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="card">
  <h2>Messages</h2>
  <p><% if (unreadCount) { %>You have <strong><%= unreadCount %></strong> unread <%= unreadCount === 1 ? 'message' : 'messages' %>.<% } else { %>No unread messages.<% } %>
    <a href="/messages">Go to messages</a></p>
</section>
<%- include('../partials/footer') %>
