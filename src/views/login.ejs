<%- include('partials/header') %>
<section class="card narrow">
  <h1>Sign in</h1>
  <p class="muted">Students, parents, instructors, and staff all sign in here.</p>
  <form method="post" action="/login" class="stack">
    <%- include('partials/csrf') %>
    <label>Username or email <input name="identifier" value="<%= identifier %>" required autofocus autocomplete="username"></label>
    <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
    <button type="submit" class="button">Sign in</button>
  </form>
  <p>New to CodeCrew? <a href="/register">Create a student or parent account</a>.</p>
  <p class="muted small">Forgot your password? Ask your instructor or CodeCrew staff to reset it.</p>
</section>
<%- include('partials/footer') %>
